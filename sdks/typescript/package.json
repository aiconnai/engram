{
  "name": "engram-client",
  "version": "0.6.0",
  "description": "TypeScript client for Engram Cloud - AI memory infrastructure",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run src/",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "engram",
    "ai",
    "memory",
    "mcp",
    "agents"
  ],
  "author": "Ronaldo Lima",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiconnai/engram-typescript-sdk"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "@types/node": "^20.0.0"
  }
}
