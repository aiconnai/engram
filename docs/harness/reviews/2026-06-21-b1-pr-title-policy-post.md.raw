+
+  echo "==> [harness] $label"
+  set +e
+  "$@"
+  actual=$?
+  set -e
+
+  if [ "$actual" -ne "$expected" ]; then
+    echo "FAIL: $label exited $actual; expected $expected" >&2
+    return 1
+  fi
+}
+
