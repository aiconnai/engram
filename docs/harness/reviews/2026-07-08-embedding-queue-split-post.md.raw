-        CreateMemoryInput {
-            content: content.to_string(),
-            memory_type: MemoryType::Note,
-            tags: vec![],
-            metadata: HashMap::new(),
-            importance: None,
-            scope: Default::default(),
-            workspace: None,
-            tier: Default::default(),
-            defer_embedding: false,
-            ttl_seconds: None,
-            dedup_mode: Default::default(),
-            dedup_threshold: None,
-            event_time: None,
