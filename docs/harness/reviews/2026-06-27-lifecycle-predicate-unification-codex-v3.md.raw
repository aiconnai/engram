   288	pub fn retention_policy_set(ctx: &HandlerContext, params: Value) -> Value {
   289	    use crate::storage::queries::set_retention_policy;
   290
   291	    let workspace = match params.get("workspace").and_then(|v| v.as_str()) {
   292	        Some(w) => w,
   293	        None => return json!({"error": "workspace is required"}),
   294	    };
   295	    let max_age_days = params.get("max_age_days").and_then(|v| v.as_i64());
   296	    let max_memories = params.get("max_memories").and_then(|v| v.as_i64());
   297	    let compress_after_days = params.get("compress_after_days").and_then(|v| v.as_i64());
   298	    let compress_max_importance = params
   299	        .get("compress_max_importance")
   300	        .and_then(|v| v.as_f64())
   301	        .map(|f| f as f32);
   302	    let compress_min_access = params
   303	        .get("compress_min_access")
   304	        .and_then(|v| v.as_i64())
   305	        .map(|i| i as i32);
   306	    let auto_delete_after_days = params
   307	        .get("auto_delete_after_days")
   308	        .and_then(|v| v.as_i64());
   309	    let exclude_types: Option<Vec<String>> = params
   310	        .get("exclude_types")
   311	        .and_then(|v| v.as_array())
   312	        .map(|arr| {
   313	            arr.iter()
   314	                .filter_map(|v| v.as_str().map(String::from))
   315	                .collect()
   316	        });
   317
   318	    ctx.storage
   319	        .with_transaction(|conn| {
   320	            let policy = set_retention_policy(
   321	                conn,
   322	                workspace,
   323	                max_age_days,
   324	                max_memories,
   325	                compress_after_days,
   326	                compress_max_importance,
   327	                compress_min_access,
   328	                auto_delete_after_days,
   329	                exclude_types,
   330	            )?;
   331	            Ok(json!(policy))
   332	        })
   333	        .unwrap_or_else(|e| json!({"error": e.to_string()}))
   334	}
