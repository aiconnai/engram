   218	pub fn memory_set_lifecycle(ctx: &HandlerContext, params: Value) -> Value {
   219	    let id = match params.get("id").and_then(|v| v.as_i64()) {
   220	        Some(id) => id,
   221	        None => return json!({"error": "id is required"}),
   222	    };
   223
   224	    let state = match params.get("state").and_then(|v| v.as_str()) {
   225	        Some(s) => s,
   226	        None => return json!({"error": "state is required"}),
   227	    };
   228
   229	    if !["active", "stale", "archived"].contains(&state) {
   230	        return json!({"error": "state must be one of: active, stale, archived"});
   231	    }
   232	    let lifecycle_state = match state.parse::<LifecycleState>() {
   233	        Ok(state) => state,
   234	        Err(_) => return json!({"error": "state must be one of: active, stale, archived"}),
   235	    };
   236
   237	    ctx.storage
   238	        .with_connection(|conn| {
   239	            match update_memory_lifecycle_state(conn, id, lifecycle_state) {
   240	                Ok(_) => {}
   241	                Err(crate::error::EngramError::NotFound(_)) => {
   242	                    return Ok(json!({"error": "Memory not found"}));
   243	                }
   244	                Err(e) => return Err(e),
   245	            }
   246
   247	            let operation_id = uuid::Uuid::new_v4().to_string();
   248	            emit_best_effort(
   249	                conn,
   250	                &EnrichmentEvent {
   251	                    operation_id: &operation_id,
   252	                    event_type: "lifecycle_transition",
   253	                    memory_id: Some(id),
   254	                    version_id: None,
   255	                    triggered_by: "memory_set_lifecycle",
   256	                    agent_id: None,
   257	                    workspace: None,
   258	                    params: json!({"state": state}),
   259	                    outcome: json!({"new_state": state}),
   260	                    status: "completed",

