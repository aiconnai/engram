    73	pub fn lifecycle_run(ctx: &HandlerContext, params: Value) -> Value {
    74	    use chrono::{Duration, Utc};
    75
    76	    let dry_run = params
    77	        .get("dry_run")
    78	        .and_then(|v| v.as_bool())
    79	        .unwrap_or(true);
    80	    let workspace = params.get("workspace").and_then(|v| v.as_str());
    81	    let stale_days = params
    82	        .get("stale_days")
    83	        .and_then(|v| v.as_i64())
    84	        .unwrap_or(30);
    85	    let archive_days = params
    86	        .get("archive_days")
    87	        .and_then(|v| v.as_i64())
    88	        .unwrap_or(90);
    89	    let min_importance = params
    90	        .get("min_importance")
    91	        .and_then(|v| v.as_f64())
    92	        .unwrap_or(0.5) as f32;
    93
    94	    let stale_cutoff = (Utc::now() - Duration::days(stale_days)).to_rfc3339();
    95	    let archive_cutoff = (Utc::now() - Duration::days(archive_days)).to_rfc3339();
    96
    97	    ctx.storage
    98	        .with_transaction(|conn| {
    99	            let stale_query = if workspace.is_some() {
   100	                "SELECT id, content FROM memories
   101	                 WHERE workspace = ?
   102	                   AND (lifecycle_state IS NULL OR lifecycle_state = 'active')
   103	                   AND created_at < ?
   104	                   AND importance < ?
   105	                   AND access_count < 5
   106	                   AND valid_to IS NULL"
   107	            } else {
   108	                "SELECT id, content FROM memories
   109	                 WHERE (lifecycle_state IS NULL OR lifecycle_state = 'active')
   110	                   AND created_at < ?
   111	                   AND importance < ?
   112	                   AND access_count < 5
   113	                   AND valid_to IS NULL"
   114	            };
   115
   116	            let stale_candidates: Vec<(i64, String)> = {
   117	                let mut stmt = conn.prepare(stale_query)?;
   118	                if let Some(ws) = workspace {
   119	                    stmt.query_map(params![ws, &stale_cutoff, min_importance], |row| {
   120	                        Ok((row.get(0)?, row.get(1)?))
   121	                    })?
   122	                    .collect::<rusqlite::Result<Vec<_>>>()?
   123	                } else {
   124	                    stmt.query_map(params![&stale_cutoff, min_importance], |row| {
   125	                        Ok((row.get(0)?, row.get(1)?))
   126	                    })?
   127	                    .collect::<rusqlite::Result<Vec<_>>>()?
   128	                }
   129	            };
   130
   131	            let archive_query = if workspace.is_some() {
   132	                "SELECT id, content FROM memories
   133	                 WHERE workspace = ?
   134	                   AND lifecycle_state = 'stale'
   135	                   AND created_at < ?
   136	                   AND valid_to IS NULL"
   137	            } else {
   138	                "SELECT id, content FROM memories
   139	                 WHERE lifecycle_state = 'stale'
   140	                   AND created_at < ?
   141	                   AND valid_to IS NULL"
   142	            };
   143
   144	            let archive_candidates: Vec<(i64, String)> = {
   145	                let mut stmt = conn.prepare(archive_query)?;
   146	                if let Some(ws) = workspace {
   147	                    stmt.query_map(params![ws, &archive_cutoff], |row| {
   148	                        Ok((row.get(0)?, row.get(1)?))
   149	                    })?
   150	                    .collect::<rusqlite::Result<Vec<_>>>()?
   151	                } else {
   152	                    stmt.query_map(params![&archive_cutoff], |row| {
   153	                        Ok((row.get(0)?, row.get(1)?))
   154	                    })?
   155	                    .collect::<rusqlite::Result<Vec<_>>>()?
   156	                }
   157	            };
   158
   159	            if dry_run {
   160	                return Ok(json!({
   161	                    "dry_run": true,
   162	                    "would_mark_stale": stale_candidates.len(),
   163	                    "would_archive": archive_candidates.len(),
   164	                    "stale_candidates": stale_candidates.iter().take(10).map(|(id, content)| {
   165	                        json!({"id": id, "preview": content.chars().take(50).collect::<String>()})
   166	                    }).collect::<Vec<_>>(),
   167	                    "archive_candidates": archive_candidates.iter().take(10).map(|(id, content)| {
   168	                        json!({"id": id, "preview": content.chars().take(50).collect::<String>()})
   169	                    }).collect::<Vec<_>>()
   170	                }));
   171	            }
   172
   173	            let mut stale_count = 0;
   174	            let mut archive_count = 0;
   175	            let mut transitioned_ids: Vec<(i64, &str)> = Vec::new();
   176
   177	            for (id, _) in &stale_candidates {
   178	                update_memory_lifecycle_state(conn, *id, LifecycleState::Stale)?;
   179	                stale_count += 1;
   180	                transitioned_ids.push((*id, "stale"));
   181	            }
   182
   183	            for (id, _) in &archive_candidates {
   184	                update_memory_lifecycle_state(conn, *id, LifecycleState::Archived)?;
   185	                archive_count += 1;
   186	                transitioned_ids.push((*id, "archived"));
   187	            }
   188
   189	            let operation_id = uuid::Uuid::new_v4().to_string();
   190	            for (mem_id, new_state) in &transitioned_ids {
   191	                emit_best_effort(
   192	                    conn,
   193	                    &EnrichmentEvent {
   194	                        operation_id: &operation_id,
   195	                        event_type: "lifecycle_transition",
   196	                        memory_id: Some(*mem_id),
   197	                        version_id: None,
   198	                        triggered_by: "lifecycle_run",
   199	                        agent_id: None,
   200	                        workspace,
   201	                        params: json!({"dry_run": dry_run}),
   202	                        outcome: json!({"new_state": new_state}),
   203	                        status: "completed",
   204	                        dry_run,
   205	                    },
   206	                );
   207	            }
   208
   209	            Ok(json!({
   210	                "dry_run": false,
   211	                "marked_stale": stale_count,
   212	                "archived": archive_count
   213	            }))
   214	        })
   215	        .unwrap_or_else(|e| json!({"error": e.to_string()}))
   216	}
