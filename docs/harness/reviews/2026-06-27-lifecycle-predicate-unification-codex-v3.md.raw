   270	pub fn lifecycle_config(_ctx: &HandlerContext, params: Value) -> Value {
   271	    let stale_days = params.get("stale_days").and_then(|v| v.as_i64());
   272	    let archive_days = params.get("archive_days").and_then(|v| v.as_i64());
   273	    let min_importance = params.get("min_importance").and_then(|v| v.as_f64());
   274	    let min_access_count = params.get("min_access_count").and_then(|v| v.as_i64());
   275
   276	    json!({
   277	        "stale_days": stale_days.unwrap_or(30),
   278	        "archive_days": archive_days.unwrap_or(90),
   279	        "min_importance": min_importance.unwrap_or(0.5),
   280	        "min_access_count": min_access_count.unwrap_or(5),
   281	        "lifecycle_enabled": std::env::var("ENGRAM_LIFECYCLE_ENABLED")
   282	            .map(|v| v != "false" && v != "0")
   283	            .unwrap_or(true),
   284	        "note": "Pass values to update configuration"
   285	    })
   286	}
