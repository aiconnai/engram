   321	fn decay_candidates(conn: &rusqlite::Connection, workspace: &str) -> Result<Vec<DecayCandidate>> {
   322	    let mut stmt = conn.prepare(
   323	        "SELECT id
   324	         FROM memories
   325	         WHERE workspace = ?1 AND valid_to IS NULL
   326	         ORDER BY updated_at ASC, id ASC
   327	         LIMIT 500",
   328	    )?;
   329	    let ids = stmt
   330	        .query_map(params![workspace], |row| row.get::<_, MemoryId>(0))?
   331	        .collect::<rusqlite::Result<Vec<_>>>()?;
   332
   333	    let mut candidates = Vec::with_capacity(ids.len());
   334	    for id in ids {
   335	        let (memory, stored_policy, _features, score) = score_memory(conn, id)?;
   336	        let current_salience = stored_policy
   337	            .as_ref()
   338	            .map(|p| p.salience_score)
   339	            .unwrap_or(score.salience_score);
   340	        let current_retention = stored_policy
   341	            .as_ref()
   342	            .map(|p| p.retention_score)
   343	            .unwrap_or(score.retention_score);
   344	        let current_priority = stored_policy
   345	            .as_ref()
   346	            .map(|p| p.retrieval_priority)
   347	            .unwrap_or(score.retrieval_priority);
   348
   349	        let new_salience = decay_score(current_salience);
   350	        let new_retention = decay_score(current_retention);
   351	        let new_priority = decay_score(current_priority);
   352	        let lifecycle_target =
   353	            if memory.lifecycle_state == LifecycleState::Active && new_retention < 0.25 {
   354	                Some(LifecycleState::Stale)
   355	            } else {
   356	                None
   357	            };
   358
   359	        candidates.push(DecayCandidate {
   360	            memory_id: id,
   361	            current_salience_score: current_salience,
   362	            current_retention_score: current_retention,
   363	            current_retrieval_priority: current_priority,
   364	            new_salience_score: new_salience,
   365	            new_retention_score: new_retention,
   366	            new_retrieval_priority: new_priority,
   367	            lifecycle_state: memory.lifecycle_state.to_string(),
   368	            lifecycle_target,
   369	            reason: format!("memory_decay:{}", score.policy_reason),
   370	        });
   371	    }
   372
   373	    Ok(candidates)
   374	}
