   149	/// Apply all retention policies. Returns total memories affected across all workspaces.
   150	pub fn apply_retention_policies(conn: &Connection) -> Result<i64> {
   151	    let policies = list_retention_policies(conn)?;
   152	    let mut total_affected = 0i64;
   153
   154	    for policy in &policies {
   155	        // 1. Auto-compress based on compress_after_days
   156	        if let Some(compress_days) = policy.compress_after_days {
   157	            let compressed = compress_old_memories(
   158	                conn,
   159	                compress_days,
   160	                policy.compress_max_importance,
   161	                policy.compress_min_access,
   162	                100,
   163	            )?;
   164	            total_affected += compressed;
   165	        }
   166
   167	        // 2. Enforce max_memories limit per workspace
   168	        if let Some(max_mem) = policy.max_memories {
   169	            let count: i64 = conn
   170	                .query_row(
   171	                    "SELECT COUNT(*) FROM memories WHERE workspace = ? AND valid_to IS NULL
   172	                     AND COALESCE(lifecycle_state, 'active') = 'active'",
   173	                    params![policy.workspace],
   174	                    |row| row.get(0),
   175	                )
   176	                .unwrap_or(0);
   177
   178	            if count > max_mem {
   179	                // Archive excess (oldest, lowest importance first)
   180	                let excess = count - max_mem;
   181	                let archived = conn.execute(
   182	                    "UPDATE memories SET lifecycle_state = 'archived'
   183	                     WHERE id IN (
   184	                        SELECT id FROM memories
   185	                        WHERE workspace = ? AND valid_to IS NULL
   186	                          AND COALESCE(lifecycle_state, 'active') = 'active'
   187	                          AND memory_type NOT IN ('summary', 'checkpoint')
   188	                        ORDER BY importance ASC, access_count ASC, created_at ASC
   189	                        LIMIT ?
   190	                     )",
   191	                    params![policy.workspace, excess],
   192	                )?;
   193	                total_affected += archived as i64;
   194	            }
   195	        }
   196
   197	        // 3. Auto-delete very old archived memories
   198	        if let Some(delete_days) = policy.auto_delete_after_days {
   199	            let cutoff = (Utc::now() - chrono::Duration::days(delete_days)).to_rfc3339();
   200	            let now = Utc::now().to_rfc3339();
   201	            let deleted = conn.execute(
   202	                "UPDATE memories SET valid_to = ?
   203	                 WHERE workspace = ? AND valid_to IS NULL
   204	                   AND lifecycle_state = 'archived'
   205	                   AND created_at < ?",
   206	                params![now, policy.workspace, cutoff],
   207	            )?;
   208	            total_affected += deleted as i64;
   209	        }
   210	    }
   211
   212	    Ok(total_affected)
   213	}
   214
   215	/// Auto-compress old, rarely-accessed memories by creating summaries and archiving originals.
   216	/// Returns the number of memories archived.
   217	pub fn compress_old_memories(
   218	    conn: &Connection,
   219	    max_age_days: i64,
   220	    max_importance: f32,
   221	    min_access_count: i32,
   222	    batch_limit: usize,
   223	) -> Result<i64> {
   224	    let cutoff = (Utc::now() - chrono::Duration::days(max_age_days)).to_rfc3339();
   225	    let now = Utc::now().to_rfc3339();
   226
   227	    // Find candidates: old, low-importance, rarely-accessed, not already archived/summary
   228	    let mut stmt = conn.prepare(
   229	        "SELECT id, content, memory_type, importance, tags, workspace
   230	         FROM (
   231	            SELECT m.id, m.content, m.memory_type, m.importance, m.access_count, m.workspace,
   232	                   COALESCE(m.lifecycle_state, 'active') as lifecycle_state,
   233	                   (SELECT GROUP_CONCAT(t.name, ',') FROM memory_tags mt JOIN tags t ON mt.tag_id = t.id WHERE mt.memory_id = m.id) as tags
   234	            FROM memories m
   235	            WHERE m.valid_to IS NULL
   236	              AND (m.expires_at IS NULL OR m.expires_at > ?1)
   237	              AND m.created_at < ?2
   238	              AND m.importance <= ?3
   239	              AND m.access_count < ?4
   240	              AND m.memory_type NOT IN ('summary', 'checkpoint')
   241	              AND COALESCE(m.lifecycle_state, 'active') = 'active'
   242	            ORDER BY m.created_at ASC
   243	            LIMIT ?5
   244	         )",
   245	    )?;
   246
   247	    let candidates: Vec<(i64, String, String, f32, Option<String>, String)> = stmt
   248	        .query_map(
   249	            params![
   250	                now,
   251	                cutoff,
   252	                max_importance,
   253	                min_access_count,
   254	                batch_limit as i64
   255	            ],
   256	            |row| {
   257	                Ok((
   258	                    row.get(0)?,
   259	                    row.get(1)?,
   260	                    row.get(2)?,
   261	                    row.get(3)?,
   262	                    row.get(4)?,
   263	                    row.get::<_, String>(5)
   264	                        .unwrap_or_else(|_| "default".to_string()),
   265	                ))
   266	            },
   267	        )?
   268	        .filter_map(|r| r.ok())
   269	        .collect();
   270
   271	    let mut archived = 0i64;
   272
   273	    for (id, content, memory_type, importance, tags_csv, workspace) in &candidates {
   274	        // Create compressed summary
   275	        let summary_text = if content.len() > 200 {
   276	            let head: String = content.chars().take(120).collect();
   277	            let tail: String = content
   278	                .chars()
   279	                .rev()
   280	                .take(60)
   281	                .collect::<String>()
   282	                .chars()
   283	                .rev()
   284	                .collect();
   285	            format!("{}...{}", head, tail)
   286	        } else {
   287	            content.clone()
   288	        };
   289
   290	        let tags: Vec<String> = tags_csv
   291	            .as_deref()
   292	            .unwrap_or("")
   293	            .split(',')
   294	            .filter(|s| !s.is_empty())
   295	            .map(|s| s.to_string())
   296	            .collect();
   297
   298	        let input = CreateMemoryInput {
   299	            content: format!("[Archived {}] {}", memory_type, summary_text),
   300	            memory_type: MemoryType::Summary,
   301	            importance: Some(*importance),
   302	            tags,
   303	            workspace: Some(workspace.clone()),
   304	            tier: MemoryTier::Permanent,
   305	            summary_of_id: Some(*id),
   306	            ..Default::default()
   307	        };
   308
   309	        if create_memory(conn, &input).is_ok()
   310	            && conn
   311	                .execute(
   312	                    "UPDATE memories SET lifecycle_state = 'archived' WHERE id = ? AND valid_to IS NULL",
   313	                    params![id],
   314	                )
   315	                .is_ok()
   316	        {
   317	            archived += 1;
   318	        }
   319	    }
   320
   321	    Ok(archived)
   322	}

