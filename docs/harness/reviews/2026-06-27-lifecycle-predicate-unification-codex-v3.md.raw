   647
   648	/// Create a new memory with deduplication support
   649	pub fn create_memory(conn: &Connection, input: &CreateMemoryInput) -> Result<Memory> {
   650	    let now = Utc::now();
   651	    let now_str = now.to_rfc3339();
   652	    let metadata_json = serde_json::to_string(&input.metadata)?;
   653	    let importance = input.importance.unwrap_or(0.5);
   654
   655	    // Compute dedup hash for duplicate detection (normalized: lowercased, whitespace-collapsed)
   656	    // This is also the stored `content_hash`, so import/export must use the same function.
   657	    let content_hash = compute_content_hash(&input.content);
   658
   659	    // Normalize workspace early for dedup checking
   660	    let workspace = match &input.workspace {
   661	        Some(ws) => crate::types::normalize_workspace(ws)
   662	            .map_err(|e| EngramError::InvalidInput(format!("Invalid workspace: {}", e)))?,
   663	        None => "default".to_string(),
   664	    };
   665
   666	    // Check for duplicates based on dedup_mode (scoped to same scope AND workspace)
   667	    if input.dedup_mode != DedupMode::Allow {
   668	        if let Some(existing) =
   669	            find_by_content_hash(conn, &content_hash, &input.scope, Some(&workspace))?
   670	        {
   671	            match input.dedup_mode {
   672	                DedupMode::Reject => {
   673	                    return Err(EngramError::Duplicate {
   674	                        existing_id: existing.id,
   675	                        message: format!(
   676	                            "Duplicate memory detected (id={}). Content hash: {}",
   677	                            existing.id, content_hash
   678	                        ),
   679	                    });
   680	                }
   681	                DedupMode::Skip => {
   682	                    // Return existing memory without modification
   683	                    return Ok(existing);
   684	                }
   685	                DedupMode::Merge => {
   686	                    // Merge: update existing memory with new tags and metadata
   687	                    let mut merged_tags = existing.tags.clone();
   688	                    for tag in &input.tags {
   689	                        if !merged_tags.contains(tag) {
   690	                            merged_tags.push(tag.clone());
   691	                        }
   692	                    }
   693
   694	                    let mut merged_metadata = existing.metadata.clone();
   695	                    for (key, value) in &input.metadata {
   696	                        merged_metadata.insert(key.clone(), value.clone());
   697	                    }
   698
   699	                    let update_input = UpdateMemoryInput {
   700	                        content: None, // Keep existing content
   701	                        memory_type: None,
   702	                        tags: Some(merged_tags),
   703	                        metadata: Some(merged_metadata),
   704	                        importance: input.importance, // Use new importance if provided
   705	                        scope: None,
   706	                        ttl_seconds: input.ttl_seconds, // Apply new TTL if provided
   707	                        event_time: None,
   708	                        trigger_pattern: None,
   709	                        media_url: input.media_url.clone().map(Some),
   710	                    };
   711
   712	                    return update_memory(conn, existing.id, &update_input);
   713	                }
   714	                DedupMode::Allow => unreachable!(),
   715	            }
   716	        }
   717	    }
   718
   719	    // Extract scope type and id for database storage
   720	    let scope_type = input.scope.scope_type();
   721	    let scope_id = input.scope.scope_id().map(|s| s.to_string());
   722
   723	    // workspace was already normalized above for dedup checking
   724
   725	    // Determine tier and enforce tier invariants
   726	    let tier = input.tier;
   727
   728	    // Calculate expires_at based on tier and ttl_seconds
   729	    // Tier invariants:
