   383	pub fn retention_policy_apply(ctx: &HandlerContext, params: Value) -> Value {
   384	    use crate::storage::queries::apply_retention_policies;
   385
   386	    let dry_run = params
   387	        .get("dry_run")
   388	        .and_then(|v| v.as_bool())
   389	        .unwrap_or(false);
   390
   391	    if dry_run {
   392	        use crate::storage::queries::list_retention_policies;
   393	        return ctx
   394	            .storage
   395	            .with_connection(|conn| {
   396	                let policies = list_retention_policies(conn)?;
   397	                Ok(json!({
   398	                    "dry_run": true,
   399	                    "policies_count": policies.len(),
   400	                    "policies": policies,
   401	                    "note": "Set dry_run=false to apply"
   402	                }))
   403	            })
   404	            .unwrap_or_else(|e| json!({"error": e.to_string()}));
   405	    }
   406
   407	    let tx_result = ctx.storage.with_transaction(apply_retention_policies);
   408
   409	    match tx_result {
   410	        Ok(affected) => {
   411	            // Emit SUCCESS event in a separate connection, outside the now-committed transaction.
   412	            if affected > 0 {
   413	                let operation_id = uuid::Uuid::new_v4().to_string();
   414	                ctx.storage
   415	                    .with_connection(|conn| {
   416	                        emit_best_effort(
   417	                            conn,
   418	                            &EnrichmentEvent {
   419	                                operation_id: &operation_id,
   420	                                event_type: "lifecycle_transition",
   421	                                memory_id: None,
   422	                                version_id: None,
   423	                                triggered_by: "retention_policy_apply",
   424	                                agent_id: None,
   425	                                workspace: None,
   426	                                params: json!({}),
   427	                                outcome: json!({"memories_affected": affected}),
   428	                                status: "completed",
   429	                                dry_run: false,
   430	                            },
   431	                        );
   432	                        Ok::<_, crate::error::EngramError>(())
   433	                    })
   434	                    .ok();
   435	            }
   436	            json!({"applied": true, "memories_affected": affected})
   437	        }
   438	        Err(e) => json!({"error": e.to_string()}),
   439	    }
   440	}
