   362	    /// `report_id` must be a valid id from `garden_log`.
   363	    pub fn garden_undo(&self, conn: &Connection, report_id: i64) -> Result<usize> {
   364	        // Load the saved report's actions JSON
   365	        let actions_json: String = conn.query_row(
