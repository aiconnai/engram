    19	                 WHERE workspace = ? AND valid_to IS NULL
    20	                 GROUP BY lifecycle_state"
    21	            } else {
    22	                "SELECT lifecycle_state, COUNT(*) as count
    23	                 FROM memories
    24	                 WHERE valid_to IS NULL
    25	                 GROUP BY lifecycle_state"
    26	            };
    27
    28	            let mut stmt = conn.prepare(query)?;
    29	            let rows: Vec<(String, i64)> = if let Some(ws) = workspace {
    30	                stmt.query_map(params![ws], |row| {
    31	                    Ok((
    32	                        row.get::<_, Option<String>>(0)?
    33	                            .unwrap_or_else(|| "active".to_string()),
    34	                        row.get::<_, i64>(1)?,
    35	                    ))
    36	                })?
    37	                .collect::<rusqlite::Result<Vec<_>>>()?
    38	            } else {
    39	                stmt.query_map([], |row| {
    40	                    Ok((
    41	                        row.get::<_, Option<String>>(0)?
    42	                            .unwrap_or_else(|| "active".to_string()),
    43	                        row.get::<_, i64>(1)?,
    44	                    ))
    45	                })?
    46	                .collect::<rusqlite::Result<Vec<_>>>()?
    47	            };
