   225	pub fn memory_archive_old(ctx: &HandlerContext, params: Value) -> Value {
   226	    use crate::storage::queries::{create_memory, list_memories};
   227	    use crate::types::{CreateMemoryInput, ListOptions, MemoryTier, MemoryType};
   228	    use chrono::{Duration, Utc};
   229	    use rusqlite::params;
   230
   231	    let max_age_days = params
   232	        .get("max_age_days")
   233	        .and_then(|v| v.as_i64())
   234	        .unwrap_or(90);
   235	    let max_importance = params
   236	        .get("max_importance")
   237	        .and_then(|v| v.as_f64())
   238	        .unwrap_or(0.5) as f32;
   239	    let min_access_count = params
   240	        .get("min_access_count")
   241	        .and_then(|v| v.as_i64())
   242	        .unwrap_or(5);
   243	    let workspace = params.get("workspace").and_then(|v| v.as_str());
   244	    let dry_run = params
   245	        .get("dry_run")
   246	        .and_then(|v| v.as_bool())
   247	        .unwrap_or(true);
   248
   249	    let cutoff_date = Utc::now() - Duration::days(max_age_days);
   250
   251	    ctx.storage
   252	        .with_connection(|conn| {
   253	            let options = ListOptions {
   254	                workspace: workspace.map(|s| s.to_string()),
   255	                limit: Some(1000),
   256	                ..Default::default()
   257	            };
   258
   259	            let all_memories = list_memories(conn, &options)?;
   260
   261	            let candidates: Vec<_> = all_memories
   262	                .into_iter()
   263	                .filter(|m| {
   264	                    m.created_at < cutoff_date
   265	                        && m.importance <= max_importance
   266	                        && m.access_count < min_access_count as i32
   267	                        && m.memory_type != MemoryType::Summary
   268	                        && m.memory_type != MemoryType::Checkpoint
   269	                })
   270	                .collect();
   271
   272	            if dry_run {
   273	                let summaries: Vec<_> = candidates
   274	                    .iter()
   275	                    .map(|m| {
   276	                        json!({
   277	                            "id": m.id,
   278	                            "memory_type": m.memory_type,
   279	                            "importance": m.importance,
   280	                            "access_count": m.access_count,
   281	                            "created_at": m.created_at.to_rfc3339(),
   282	                            "content_preview": m.content.chars().take(100).collect::<String>()
   283	                        })
   284	                    })
   285	                    .collect();
   286
   287	                return Ok(json!({
   288	                    "dry_run": true,
   289	                    "would_archive": candidates.len(),
   290	                    "candidates": summaries
   291	                }));
   292	            }
   293
   294	            let mut archived = 0;
   295	            let mut errors: Vec<String> = Vec::new();
   296	            let operation_id = uuid::Uuid::new_v4().to_string();
   297
   298	            for memory in candidates {
   299	                let summary_text = if memory.content.len() > 200 {
   300	                    let head: String = memory.content.chars().take(120).collect();
   301	                    let tail: String = memory
   302	                        .content
   303	                        .chars()
   304	                        .rev()
   305	                        .take(60)
   306	                        .collect::<String>()
   307	                        .chars()
   308	                        .rev()
   309	                        .collect();
   310	                    format!("{}...{}", head, tail)
   311	                } else {
   312	                    memory.content.clone()
   313	                };
   314
   315	                let input = CreateMemoryInput {
   316	                    content: format!("[Archived {:?}] {}", memory.memory_type, summary_text),
   317	                    memory_type: MemoryType::Summary,
   318	                    importance: Some(memory.importance),
   319	                    tags: memory.tags.clone(),
   320	                    workspace: Some(memory.workspace.clone()),
   321	                    tier: MemoryTier::Permanent,
   322	                    summary_of_id: Some(memory.id),
   323	                    ..Default::default()
   324	                };
   325
   326	                match create_memory(conn, &input) {
   327	                    Ok(_) => {
   328	                        match conn.execute(
   329	                            "UPDATE memories SET lifecycle_state = 'archived' WHERE id = ? AND valid_to IS NULL",
   330	                            params![memory.id],
   331	                        ) {
   332	                            Ok(_) => {
   333	                                archived += 1;
   334	                                emit_best_effort(
   335	                                    conn,
   336	                                    &EnrichmentEvent {
   337	                                        operation_id: &operation_id,
   338	                                        event_type:   "compression",
   339	                                        memory_id:    Some(memory.id),
   340	                                        version_id:   None,
   341	                                        triggered_by: "memory_archive_old",
   342	                                        agent_id:     None,
   343	                                        workspace:    Some(memory.workspace.as_str()),
   344	                                        params:       json!({}),
   345	                                        outcome:      json!({"new_state": "archived"}),
   346	                                        status:       "completed",
   347	                                        dry_run:      false,
   348	                                    },
   349	                                );
   350	                            }

