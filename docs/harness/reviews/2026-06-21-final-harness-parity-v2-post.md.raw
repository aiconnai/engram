+use subtle::ConstantTimeEq;
@@ -158 +159,6 @@ impl<'a> ApiKeyManager<'a> {
-                hash_key_with_salt(raw_key, salt) == *stored_hash
+                // Constant-time comparison to avoid leaking the stored hash via
