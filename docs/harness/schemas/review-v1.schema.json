{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiconnai.github.io/engram/schemas/review-v1.schema.json",
  "title": "Engram Harness Review Report v1",
  "description": "Schema for structured review reports generated by independent reviewer agents in the Engram harness.",
  "type": "object",
  "required": [
    "review_id",
    "base_sha",
    "head_sha",
    "intensity",
    "lanes",
    "findings",
    "verdict"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Schema version identifier for the review report.",
      "type": "string",
      "const": "review-v1"
    },
    "review_id": {
      "description": "Unique identifier for this review report.",
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "base_sha": {
      "description": "Base Git commit SHA (40-character lowercase hexadecimal).",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "description": "Candidate Head Git commit SHA (40-character lowercase hexadecimal).",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "intensity": {
      "description": "Authorized review intensity profile.",
      "type": "string",
      "enum": [
        "low",
        "med",
        "medium",
        "high",
        "xhigh",
        "max",
        "ultra"
      ]
    },
    "lanes": {
      "description": "List of independent evidence lanes evaluated during the review.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "findings": {
      "description": "List of structured review findings.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "path",
          "category",
          "severity",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "description": "Unique finding identifier within the review.",
            "type": "string",
            "minLength": 1
          },
          "path": {
            "description": "Repo-relative file path associated with the finding.",
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$"
          },
          "line": {
            "description": "1-based line number in the head revision.",
            "type": "integer",
            "minimum": 1
          },
          "category": {
            "description": "Category of the finding.",
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "style",
              "performance",
              "contract",
              "test",
              "docs",
              "general"
            ]
          },
          "severity": {
            "description": "Severity level of the finding.",
            "type": "string",
            "enum": [
              "blocker",
              "critical",
              "high",
              "medium",
              "low",
              "info",
              "warn"
            ]
          },
          "message": {
            "description": "Detailed explanation of the finding.",
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "description": "Concrete code snippet or command output demonstrating the finding.",
            "type": "string"
          },
          "suggested_fix": {
            "description": "Optional remediation guidance or suggested replacement.",
            "type": "string"
          }
        }
      }
    },
    "verdict": {
      "description": "Overall verdict from the review.",
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "comment",
        "request_changes",
        "PASS",
        "FAIL",
        "COMMENT",
        "REQUEST_CHANGES"
      ]
    },
    "reviewer": {
      "description": "Identifier of the reviewer model or persona.",
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "description": "UTC RFC 3339 timestamp when the review was concluded.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "summary": {
      "description": "Executive summary of the review results.",
      "type": "string"
    },
    "metadata": {
      "description": "Optional metadata such as token usage, duration, or coverage counts.",
      "type": "object"
    }
  }
}
