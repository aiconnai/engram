{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiconnai.github.io/engram/schemas/review-v2.schema.json",
  "title": "Engram Harness Review Report v2",
  "description": "Hardened review report. Structure only: a valid report is not an authenticated review and never authorizes a merge.",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "review_id",
    "base_sha",
    "head_sha",
    "intensity",
    "lanes",
    "findings",
    "verdict",
    "reviewer",
    "timestamp"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "description": "Schema version identifier.",
      "type": "string",
      "const": "review-v2"
    },
    "policy_version": {
      "description": "Policy version the artifact was produced under. The validator never trusts this value: the caller passes the expected policy version out of band.",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 1,
      "maxLength": 64
    },
    "review_id": {
      "description": "Unique identifier for this review report.",
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]+$",
      "minLength": 1,
      "maxLength": 128
    },
    "base_sha": {
      "description": "Base Git commit SHA.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "head_sha": {
      "description": "Reviewed head Git commit SHA.",
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "minLength": 40,
      "maxLength": 40
    },
    "intensity": {
      "description": "Review intensity profile.",
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ]
    },
    "lanes": {
      "description": "Independent evidence lanes evaluated.",
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "findings": {
      "description": "Structured findings.",
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "path",
          "category",
          "severity",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "finding_id": {
            "description": "Unique finding identifier within the review.",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$",
            "minLength": 1,
            "maxLength": 128
          },
          "path": {
            "description": "Repo-relative file path associated with the finding.",
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[a-zA-Z0-9_./-]+$",
            "minLength": 1,
            "maxLength": 512
          },
          "line": {
            "description": "1-based line number in the head revision.",
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          },
          "category": {
            "description": "Category of the finding.",
            "type": "string",
            "enum": [
              "correctness",
              "security",
              "style",
              "performance",
              "contract",
              "test",
              "docs",
              "general"
            ]
          },
          "severity": {
            "description": "Severity of the finding. blocker, critical and high are blocking.",
            "type": "string",
            "enum": [
              "blocker",
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "message": {
            "description": "Detailed explanation of the finding.",
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "evidence": {
            "description": "Concrete snippet or command output demonstrating the finding.",
            "type": "string",
            "maxLength": 8192
          },
          "suggested_fix": {
            "description": "Optional remediation guidance.",
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "verdict": {
      "description": "Overall verdict; must agree with the findings.",
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "comment",
        "request_changes"
      ]
    },
    "reviewer": {
      "description": "Reviewer identity claimed by the report (not verified here).",
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "timestamp": {
      "description": "UTC RFC 3339 timestamp when the review concluded.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$",
      "minLength": 20,
      "maxLength": 30
    },
    "summary": {
      "description": "Executive summary.",
      "type": "string",
      "maxLength": 8192
    },
    "metadata": {
      "description": "Optional string metadata.",
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_.-]+$",
        "minLength": 1,
        "maxLength": 64
      },
      "additionalProperties": {
        "type": "string",
        "maxLength": 512
      }
    }
  }
}
